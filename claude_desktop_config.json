{
  "mcpServers": {
    "postgres": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "POSTGRES_URL",
        "mcp/postgres",
        "postgresql://seu_usuario:sua_senha@host.docker.internal:5432/nome_banco?schema=nome_schema"
      ],
      "env": {
        "POSTGRES_URL": "postgresql://seu_usuario:sua_senha@host.docker.internal:5432/nome_banco?schema=nome_schema"
      }
    }
  }
}
